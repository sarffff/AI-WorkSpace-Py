# 数据库配置
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_workspace_py

# 服务器配置
PORT=3000

# LLM API 配置
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4.5-air
# 流式请求附带 stream_options.include_usage 以拿到真实 token 用量;
# 提供商不支持时会自动停发并改用本地估算
LLM_STREAM_USAGE=true
# 主回答调用的上界。不设的话吃 SDK 默认 600s × 3 = 最坏 1800 秒,而这条路径上
# 挂着一个数据库会话和一条 SSE 连接——连接池打满就是全站不可用。
#
# **流式下这个值的语义是"两个分片之间最多等多久",不是整条流的总时长**:每收到
# 一个分片就重置,所以正常输出的长回答不会被它切断,被拦住的是"连上了但不再吐
# 字节"的挂死连接。整条流的总长另有 AGENT_MAX_TOOL_ROUNDS 与字符预算兜着。
LLM_CHAT_TIMEOUT_SECONDS=120
# 重试 2 次:主回答没有降级路径,失败就是用户看到报错,值得多试。
# 重试只发生在开流之前,不会让用户看到重复内容
LLM_CHAT_MAX_RETRIES=2
# 辅助调用(重排/HyDE/改写/摘要)单独收紧:它们**全都有降级路径**,
# 为一个可以放弃的增强等 10 分钟是纯亏
LLM_AUXILIARY_TIMEOUT_SECONDS=60
LLM_AUXILIARY_MAX_RETRIES=1

# 模型路由(留空回退 LLM_MODEL)
# 辅助任务(历史摘要/查询改写/重排/指代消解/记忆抽取)用的便宜模型,
# 这些任务调用频次高、对推理能力要求低,与主回答同价是纯浪费
LLM_UTILITY_MODEL=
# 裁判模型:LLM-as-judge 的底线是裁判与被评模型分开(自我偏好会污染变体
# 对比结论)。留空依次回退 LLM_UTILITY_MODEL / LLM_MODEL
JUDGE_MODEL=

# Embedding 配置 (留空则回退到 LLM_API_KEY / LLM_BASE_URL)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=embedding-2
# 单次 embeddings 请求最多提交多少条文本(长文档分批发送)
EMBEDDING_BATCH_SIZE=32
RAG_MIN_SCORE=0.3
RAG_TOP_K=5
# true: 首轮之前先检索一次并注入上下文(可靠,但每轮固定消耗一次检索)
# false: 纯 agentic RAG,完全由模型自主决定何时检索
RAG_PREFETCH=true
# 预检索前先把追问改写成自包含问题(指代消解)。"那它的赔偿标准呢?"这类
# 省略式提问拿原文检索会召回漂移。仅在有历史消息时发起,首轮不额外花钱
RAG_CONDENSE_QUERY=true

# 跨会话长期记忆
# 每轮回答后用辅助模型抽取用户事实/偏好,跨会话注入(用户可经 /memories 查看
# 与删除)。关掉即回到"每个会话从零认识用户"
MEMORY_ENABLED=true
# 每用户保留的记忆条数上限(超量丢最旧)
MEMORY_MAX_ITEMS=100
# 每轮注入上下文的记忆条数上限
MEMORY_INJECT_LIMIT=20
# 单条记忆字符上限
MEMORY_ITEM_MAX_CHARS=200
# 抽取那次辅助模型调用的输出上限。给小了会让记忆功能静默失效:推理型模型会先
# 花掉一部分预算思考,预算不够时返回空串,抽取解析不出 JSON 就"这轮不记"——
# 表现为用户永远没有长期记忆,日志却是干净的。实测 512 不够、1024 刚够。
MEMORY_EXTRACT_MAX_TOKENS=2048

# 检索管线
# 稠密向量 + BM25 双路召回后 RRF 融合;关闭则退化为纯向量检索,便于对照实验
RAG_HYBRID=true
# 每条召回通道各取多少候选进入融合
RAG_CANDIDATES_PER_CHANNEL=20
# 命中分块前后各带几个相邻分块补全上下文(0 关闭)
RAG_CONTEXT_WINDOW=1
# 多查询改写:提召回,每次检索多一次模型调用
RAG_MULTI_QUERY=false
RAG_MULTI_QUERY_COUNT=2
# LLM listwise 重排:提精度,每次检索多一次模型调用
RAG_RERANK=false
RAG_RERANK_CANDIDATES=20
RAG_RERANK_SNIPPET_CHARS=500
# 重排方式: off | llm | api。留空则按 RAG_RERANK 布尔量决定(true -> llm)
#   llm — 让通用模型输出一个编号顺序。留着当对照组
#   api — 专用 cross-encoder。query 与 document 拼在一起过一遍模型输出标量相关度,
#         这是它比稠密检索准的原因:稠密是 bi-encoder,两侧各自独立编码,
#         编码时从未见过对方
#
# ⚠️ mode=api 之前:确认你的账号真的开通了 rerank。2026-08-23 实测智谱 /rerank
# 返 429 / code 1113(无该项额度),而 chat 用同一个 key 是 200。**配了没额度不会
# 报错,只会静默退回融合序**,报告里看着就是"专用重排没有增益"。
# 现在这种失败会打 warning 并带上 HTTP 状态码与 provider code(见 services/rerank.py),
# 检索报告里也会出现 degraded_stage=rerank。
#
# 已验证可用的替代(SiliconFlow,BAAI/bge-reranker-v2-m3 非 Pro 层免费):
#   RAG_RERANK_MODE=api
#   RERANK_BASE_URL=https://api.siliconflow.cn/v1
#   RERANK_API_KEY=<SiliconFlow 的 key,与 EMBEDDING_API_KEY 同一个>
#   RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_MODE=
RERANK_MODEL=rerank
# 留空回退 LLM_BASE_URL / LLM_API_KEY —— 同一家提供商时 rerank 与对话共用凭证。
# 换成别家(如上面的 SiliconFlow)时这两项都要显式填,否则会拿 A 家的 key
# 去请求 B 家的端点,表现是 401。
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_TIMEOUT_SECONDS=10.0
# HyDE:先让模型编一段假答案,**只拿它喂稠密通道**(BM25 继续用原始 query)。
# 两路都换等于亲手废掉稀疏通道:假答案里的编号和专有名词全是编的
RAG_HYDE=false
# 原值 200 不够(见下面「辅助调用的输出预算」):假答案只有 88 字,但思考先花光
RAG_HYDE_MAX_TOKENS=2048
# 查询路由:判断偏字面还是偏语义,据此调 RRF 两路权重。
# eval 数据集的 probe 标注天生就是这个分类器的标注集,所以它的准确率可测
RAG_QUERY_ROUTE=false
RAG_RRF_DENSE_WEIGHT=1.0
RAG_RRF_SPARSE_WEIGHT=1.0
RAG_ROUTE_WEAK_WEIGHT=0.4

# 辅助调用的输出预算
# 这几个数是实测出来的,不是调参空间。glm-4.5-air 这类混合推理模型会先花
# max_tokens 思考,预算不够时返回**空串**(不是截断的 JSON)。而每个调用方都
# 合理地把失败当成"这是增强不是依赖"静默降级,于是:
#   路由/HyDE/多查询/重排 四个增强从未真的执行过,
#   eval/variants.py 里对应的 5 个变体与 baseline 逐位相同,
#   报告上读作"这个技术没有增益"。
#
# 两个脚本配套验收,顺序不能反:
#   scripts/probe_structured_budgets.py   七个调用点是不是全都活着(快)
#   scripts/sweep_worst_case_budgets.py   按输入上界扫最低通过值(慢,但必须)
# 第二个不能省:第一个用玩具输入,对"输入随配置增长"的调用点会给假绿灯。
# 实测 rerank 在 5 个候选下 1024 通过、在生产的 20 个候选下 3072 才通过。
#
# 为什么可以大方给:max_tokens 是**上界不是账单**,计费按真实输出 token。
# 而失效那侧要为思考的 token 全额付费然后拿回一个空串。
# 现在这类失效会被记下来:finish_reason=length 且正文为空时打 warning,
# 并在 span 上落 truncated / structured.<purpose>.budget_exhausted。
RAG_ROUTE_MAX_TOKENS=2048
RAG_MULTI_QUERY_MAX_TOKENS=2048
# 输入随 RAG_RERANK_CANDIDATES × RAG_RERANK_SNIPPET_CHARS 放大,所以给得最多。
# 合成语料扫出来的下限是 3072,但真实语料下 6144 仍有约 12% 返回空串——
# 输入会被配置放大的调用点必须按真实数据校准,合成输入只给下界
RAG_RERANK_MAX_TOKENS=12288
# 指代消解是唯一默认开启的受害者:每一次追问都在拿原文检索
RAG_CONDENSE_MAX_TOKENS=4096

# 摄取层清洗
# 脏输入不是"质量差一点",它会让召回通道整条失效:GBK 文档被 errors="replace"
# 变成一串 U+FFFD 之后 tokenize() 返回空,BM25 建索引时整块跳过——稀疏通道
# 彻底看不见这篇文档,而状态还是 indexed。关掉即退回改动前的行为(对照组)
INGEST_CLEAN=true
# 非 utf-8 文档的解码先验(逗号分隔,按顺序严格试)。
# 为什么需要先验:同一串中文字节在 GB18030 / EUC-KR / Shift-JIS 下都能严格解通,
# 从字节本身分辨不了,任何检测器都不行(实测一段 GBK 短句会被判成 EUC-KR)。
# 代价:一份真正的韩文文档会被当成中文解错
INGEST_ENCODING_HINTS=gb18030
# 用 pdfplumber 的字号与坐标恢复标题层级、剔页眉页脚、修词内空格。
# 这是让 chunking 那四件事对 PDF 重新生效的唯一途径:PyPDF2 只给字符串没有字号。
# 开着时 pdfplumber 是必需依赖,缺了会拒绝启动(静默降级会让 eval 结论依赖环境)
INGEST_PDF_STRUCTURE=true
# 可读字符占比(1 − U+FFFD 替换符占比)低于此值即判 failed。
# 2026-08-23 从 0.6 提到 0.9:实测 GBK 文档硬解 utf-8 后 ratio 落在 0.2755–0.6547
# (ASCII 越多上界越高,技术文档中文全毁也能拿 0.65),有一篇 0.6011 刚好过了旧门槛,
# 状态 indexed 但 BM25 只剩 ASCII 残留、中文查询全不命中。正常语料实测都是 1.0000,
# 与坏文档之间是大片空白,所以 0.9 零误伤。**不要往回调到 0.6。**
INGEST_MIN_TEXT_RATIO=0.9
# 页眉页脚的判据是"在至少这么多页的相同边缘区域重复出现"
INGEST_HEADER_FOOTER_MIN_PAGES=3
# 索引完成后抽一块回去检索,命中不了自己就记 warning。
# 这是把"索引成功"的判据从"没抛异常"换成"真的检索得到"
INGEST_SELF_CHECK=true

# 向量存储
# memory | qdrant
# memory 是进程内 FAISS/numpy 索引,每次进程重启从 MySQL 重建。限制很具体:
# **多 worker 部署时每个 worker 各建一份**,于是一次上传之后哪个 worker 能检索到
# 取决于请求打到了谁身上。qdrant 把向量变成持久态:多 worker 共享、重启不丢。
# 切换是显式动作 —— 它需要一个跑着的服务(docker-compose.qdrant.yml)
VECTOR_STORE=memory
# exact | hnsw(只作用于 memory 后端)。
# exact 是暴力扫描,召回率恒 100%。hnsw 拿召回换延迟,**在当前语料规模下只会更差**
# ——它存在的意义是让"ANN 的代价"变成能量出来的数,而不是一句口号
VECTOR_ANN=exact
VECTOR_HNSW_M=16
VECTOR_HNSW_EF_CONSTRUCT=100
VECTOR_HNSW_EF_SEARCH=64
QDRANT_URL=http://localhost:6333
# Qdrant 默认无鉴权。暴露到公网时必须设,否则等于把整个知识库向量公开
QDRANT_API_KEY=
QDRANT_COLLECTION=ai_workspace_chunks
QDRANT_TIMEOUT_SECONDS=5.0

# 分块配置
# token 计数器: heuristic(零依赖估算) | tiktoken(精确,需额外安装且首次会下载词表)
TOKEN_COUNTER=heuristic
CHUNK_MAX_TOKENS=320
# 仅在单个超长块被硬切时生效;跨段上下文由检索阶段的邻域扩展补全
CHUNK_OVERLAP_TOKENS=40
# structural | semantic
# structural 按 Markdown 结构切(标题层级、代码围栏、段落),零成本。
# semantic 按相邻句向量的余弦距离找断点——话题真正转折的地方才断,而不是恰好
# 写了个空行的地方;代价是入库时 embedding 调用量大约翻倍(句向量找边界 +
# 块向量建索引)。检索侧不多花一分钱。
# 不做 late chunking:它需要 token 级 hidden states,而 /embeddings 只返回池化向量
CHUNK_STRATEGY=structural
CHUNK_SEMANTIC_PERCENTILE=95.0
CHUNK_SEMANTIC_MIN_SENTENCES=6

# 对话历史
# 历史消息的 token 预算(不含系统提示词与当前问题)
HISTORY_TOKEN_BUDGET=4000
# 每轮从数据库取回多少条备选,再由 token 预算决定保留几条
HISTORY_FETCH_LIMIT=80
# 超出预算的早期历史压成滚动摘要(关闭则直接丢弃)
HISTORY_SUMMARY=true
# 七个辅助调用点里输入唯一没有硬截断的一个:滑出预算的历史有多少就压多少。
# 实测最低 2048(提示词 15945 字),400 和 1024 都返回空串——空摘要会让这个
# 开关静默退化成 false。这个数管两件冲突的事:给思考的余地 + 摘要长度上限
# (摘要要进 HISTORY_TOKEN_BUDGET)。API 只有一个旋钮,所以这里给够思考,
# 长度靠 prompts/history_summary/ 那句"压缩成要点摘要"约束。摘要变啰嗦时
# 去提示词里加字数上限,不要把这个数调小。
HISTORY_SUMMARY_MAX_TOKENS=4096

# 语义缓存
# 默认关闭：嵌入向量对时间、否定这类"改变答案"的差异不敏感，
# 命中一条相似但不同的问题会直接答错。开启即接受这个取舍。
SEMANTIC_CACHE_ENABLED=false
# 余弦相似度阈值，应该用评估集扫出来而不是拍脑袋
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_MAX_ENTRIES=200

# 安全护栏
# 关闭后检索内容原样拼进提示词(仅建议排查护栏误报时临时关闭)
GUARDRAIL_ENABLED=true
# 注入模式累计分数达到该值时整段检索结果不再注入,0 = 只标记不拦截。
# 默认只观测:误报的表现是"明明有资料却答不出来",比漏报更难排查。
GUARDRAIL_BLOCK_SCORE=0

# 提示词版本
# 正文在 back-end/prompts/<key>/<version>.md,这里只选用哪一版。
# 改这个只改默认值:界面上的提示词实验台是按请求覆盖的,不会写到这里。
#
# 这几项都是**覆盖项**,留空 = 用 prompt_library.SPECS 里的 default_version。
# 那儿才是默认版本的事实来源(紧挨着该 key 的占位符契约),这里写死一个版本号
# 就等于把同一个值抄了两遍。启动日志会打出真正生效的版本,以那个为准。
#
# 想固定某一版时再填,例如回归排查、或按下面 AGENT_DELEGATION_MODE 的要求配对。
PROMPT_CHAT_SYSTEM_VERSION=
# 离线评估用的回答提示词。eval/variants.py 会覆盖它做 A/B,
# 所以跑评估时这里配什么都不影响报告里的数字。
PROMPT_EVAL_ANSWER_VERSION=
# 子代理提示词。三个角色各自一项——共享一个开关就没法单独 A/B 某个角色。
# 只在 AGENT_DELEGATION_MODE 不是 off 时才有意义。
PROMPT_AGENT_RESEARCHER_VERSION=
PROMPT_AGENT_ANALYST_VERSION=
PROMPT_AGENT_CRITIC_VERSION=

# 时区
# 应用写入 naive DATETIME 列时用的时区偏移(小时),必须与数据库服务器墙上时间一致。
# 业务表的 created_at 用 MySQL 的 func.now(),这里配错会让消息时间和 trace 时间错开。
APP_TZ_OFFSET_HOURS=8

# 可观测性
# 关闭后所有埋点变成空操作,不写 trace_spans 表
TELEMETRY_ENABLED=true
# 单条 span 的 attributes JSON 上限(只存元数据,不存提示词)
TELEMETRY_ATTR_MAX_CHARS=2000
# 价目表路径,文件不存在时成本一律显示为"未知"
# 复制 model_prices.example.json 为 model_prices.json 并填入真实价格
PRICING_CONFIG_PATH=model_prices.json
# /metrics/usage 的默认统计窗口(天)
METRICS_DEFAULT_DAYS=7

# ---- 用量闸门(按用户,不是按 IP) ----
# 三个上界互相独立,分别防三件事,全为 0 等于关闭:
#   频率  防滥用。进程内计数,每个请求都算(包括早早失败的)
#   成本  防超支。读 trace_spans.cost,也就是真实记账
#   token 成本的兜底。价目表里没有的模型 cost 是 NULL,只卡成本会被绕过
#
# 为什么不用 slowapi:它按 IP 限流(同一间办公室的人会被算成一个),而且表达不了
# 成本配额。详见 services/usage_guard 的模块文档。
USAGE_GUARD_ENABLED=true
# 频率:窗口(分钟)与窗口内的请求数上限
USAGE_RATE_WINDOW_MINUTES=1
USAGE_RATE_MAX_REQUESTS=20
# 成本与 token 的统计窗口(小时)。滑动窗口,不按自然日对齐——按自然日对齐会在
# 午夜给出一整份新配额,"卡住了就等到零点"就成了一种可行的绕过方式
USAGE_QUOTA_WINDOW_HOURS=24
# 每用户每窗口的成本上限,单位与 model_prices.json 的 currency 一致。0 = 不限。
# 混币种时各币种独立比较,不做汇率换算(项目里没有汇率来源)
USAGE_QUOTA_MAX_COST=0
# 每用户每窗口的 token 上限(输入+输出)。0 = 不限
USAGE_QUOTA_MAX_TOKENS=0

# Agent 循环配置
# 单次回答允许的最大模型轮次;最后一轮不下发工具,强制模型作答
AGENT_MAX_TOOL_ROUNDS=6
# 单个工具结果注入上下文的字符上限
TOOL_RESULT_MAX_CHARS=4000
# 一次回答中所有工具结果的总字符预算
TOOL_RESULT_TOTAL_CHARS=12000
# 同一个 (工具, 参数) 在一次回答里最多执行几次,第 N 次起不再执行,改为回灌一句
# 纠正说明("这条路走过了,换参数或直接作答")。轮次上限和字符预算都管不到重复
# 调用——它每次都是合法调用、都在预算内,只是拿回来的东西一模一样。
# 0 = 关闭检测。算的是总次数不是"连续三次":在两个相同查询之间来回摆是同一种病。
AGENT_REPEAT_LIMIT=3

# 提示词缓存(provider 侧上下文缓存)
# 智谱等 OpenAI 兼容端点的上下文缓存是隐式的:没有请求参数、没有 cache_control
# 断点,提供商自己识别与之前请求相同的前缀并复用,命中的 token 打折计费。
# 所以工程上能做的只有一件事:让前缀真的逐字一致。
# 开启后系统提示词按 prefetched=false 渲染,"已预检索过、不要重复检索"改从用户
# 消息里给。关掉即回到改动前——那时 messages[0] 会随预检索命中与否在两种正文
# 之间来回切,而它是整个前缀的第一条消息,一变就是整段缓存作废。
# 命中情况看 /metrics/usage 的 promptCacheHitRate 与 trace 里的 cache_hit_ratio。
PROMPT_CACHE_STABLE_PREFIX=true

# 结构化输出
# 模型返回的 JSON 解析或 Pydantic 校验失败时的重试次数。重试会把校验报错原文
# 回灌给模型让它自己改(和工具参数校验失败时回灌 INVALID_ARGUMENTS 同一套路)。
# 作用于:多查询改写、listwise 重排、记忆抽取、LLM 裁判。
# 0 = 不重试,各调用方直接走降级路径(用原查询/用融合序/这轮不记记忆)。
STRUCTURED_OUTPUT_RETRIES=1

# 工具轨迹(跨回合记忆)
# 回合内工具结果靠 messages 回灌,回合一结束那个列表就没了,落库的只有最终回答。
# 开启后每步工具执行会存进 message_tool_steps,下一回合按预算回灌成一段记录,
# 模型才知道自己上一回合读过什么。关掉即退回"每个回合从零开始",可作为对照。
TOOL_HISTORY_ENABLED=true
# 回灌的 token 预算,超出的部分从最旧的步骤开始丢
TOOL_HISTORY_TOKEN_BUDGET=600
# 单步摘要的字符上限。太小就只剩工具名,太大不如让模型重新调一次工具
TOOL_HISTORY_STEP_CHARS=240
# 每回合从数据库取回多少条备选步骤,再由 token 预算决定留几条
TOOL_HISTORY_FETCH_LIMIT=20
# 单步结果落库的字符上限。存的是原始正文,不是摘要
TOOL_HISTORY_STORE_MAX_CHARS=4000

# Workspace 工具
# 知识库那三个工具由界面上的「知识库」开关控制,这里几个各自独立:查网页、算数、
# 读附件都不需要知识库。默认全部关闭——打开一个工具就是把它的失败模式和攻击面
# 一起打开。打开之后建议把 PROMPT_CHAT_SYSTEM_VERSION 切到 v4-workspace,
# 默认的 v2 只讲了知识库那三个工具（不切只会收到一条启动警告，不影响运行）。
TOOL_CALCULATE_ENABLED=false
# 多代理协作(委派)
# off        : 单代理,与关掉此功能前逐位相同(默认)
# augment    : 主代理保留全部工具,额外多一个 delegate,自己判断什么时候值得派人
# supervisor : 专用工具从主代理手里收走,只留 delegate 与不属于任何角色的工具
# 开之前先在 /traces 里看清单代理模式下到底是哪一步不够用:每次委派都是一个完整的
# 嵌套子代理循环,成本与延迟都会上去,而这在单次调用里看不出来。
# 提示词必须跟着模式一起换,否则启动会直接失败(而不是静默跑错):
#   augment    -> PROMPT_CHAT_SYSTEM_VERSION=v5-augment
#   supervisor -> PROMPT_CHAT_SYSTEM_VERSION=v6-supervisor
# 两版讲的不是同一件事:augment 下主代理保留全部工具,delegate 只是多一个选项;
# supervisor 下那些工具被角色收走,主代理只能委派。用错版本会让模型按"我自己能
# 查知识库"去规划,然后发现没有那个工具。
AGENT_DELEGATION_MODE=off
# 一次回答里最多委派几次。AGENT_MAX_TOOL_ROUNDS 管不到子代理的轮次,得单独设上限。
AGENT_MAX_DELEGATIONS=3

# 显式规划(plan-and-execute)
# off          : 纯 ReAct,与加这个功能之前逐位相同(默认)
# plan_execute : 进循环之前先让辅助模型把问题拆成有序步骤,计划作为一条指引注入,
#                然后照常跑现在这个执行循环
#
# 不是替换 ReAct:"边走边看"在工具结果不确定时是优势(检索空了就换查询,这件事
# 计划里写不出来)。规划补的是**事前的全局视野**,它该压住的是"一次只想一步、
# 于是漏掉问题的另一半"——实测 multi_domain 那几条追问就是这个形状:
# 模型拿预检索给到的半边作答,缺的那半不会自己回头去找。
#
# 已知失效模式是给简单问题硬凑步骤,所以提示词里明写"空计划是正确答案"。
# 收益先量再说(eval 的 plan-execute 变体),该盯的顺序是:
#   计划步数 -> 计划遵从率 -> 关键词命中/轮次/成本
# 步数为 0 就别看后面两个:那要么是"不用分步",要么是规划静默失效了。
AGENT_PLAN_MODE=off
# 计划最多几步。这是校验不是截断:超了让模型重写,而不是砍掉多余的步骤
AGENT_PLAN_MAX_STEPS=5
# 规划那次调用的输出预算。按思考开销给,不是按"够输出五行 JSON"给
# ——见上面「辅助调用的输出预算」那段踩过的坑
AGENT_PLAN_MAX_TOKENS=2048

# 状态快照与中断恢复
# 关掉即退回"一个回合的状态只活在 SSE 生成器的局部变量里":连接一断就没了。
# 于是没有人工审批(它要跨请求)、没有重放、也没有 agent_runs 记录。
#
# 打开的代价是实打实的:每轮工具执行前写一份快照,而快照就是整个 messages 列表,
# 六轮下来几十 KB。所以 AGENT_CHECKPOINT_KEEP 会把老快照清掉。
AGENT_CHECKPOINT_ENABLED=false
# 每个 run 保留最近几份快照,0 = 不清理。留多份是为了重放("回到第 3 轮再跑一次"),
# 只留最新一份的话恢复就只有"继续"一个方向。
AGENT_CHECKPOINT_KEEP=8
# 等待审批的执行多久算废弃(小时)。0 = 永不过期。
#
# 超时的 run 不会自动执行也不会自动拒绝——自动裁决比一直挂着更危险。它会被标成
# ``abandoned``(不是 failed:这次执行没出错,是没人来裁决;标 failed 会让错误率
# 把无人处理的审批也算成故障),对应的审批记录标成 ``expired``(不是 rejected:
# 拒绝是人做的决定,过期是没人做决定,审计上完全是两件事)。
#
# 到点之后**恢复会被拒绝**,理由不只是清理:那时工具面会按当下的权限重建,
# 当初批准的语境早就不存在了。清理挂在 /chats/runs/pending 这个读路径上,
# 而恢复那边另有一道独立判断,不依赖清理跑过。
AGENT_APPROVAL_TIMEOUT_HOURS=24

# 人工审批
# off    : 不审批。破坏性操作仍受确认令牌约束(见 TOOL_DELETE_KNOWLEDGE_ENABLED)
# write  : 写操作执行前停下来等人点同意(save_to_knowledge_base / delete_knowledge_document)
# listed : 完全由 AGENT_APPROVAL_TOOLS 决定,一个都不隐含
#
# 依赖 AGENT_CHECKPOINT_ENABLED=true。审批要等用户在**另一个请求**里点同意,
# 没有快照就没有东西可恢复;只开审批不开快照会在启动日志里给出警告。
#
# 与确认令牌的分工:令牌扫的是用户原话里有没有"删除"这类字眼(启发式,必然有假阳假阴),
# 审批是真的停下来问一次。两层都留着——审批关着时令牌仍是唯一门槛。
AGENT_APPROVAL_MODE=off
# listed 模式下的工具名,逗号分隔。给 web_search 加审批能立刻体会到
# "每一步都要点同意"的代价,这件事讲道理讲不清,试一次就清楚了。
AGENT_APPROVAL_TOOLS=
TOOL_READ_ATTACHMENT_ENABLED=false
TOOL_WEB_SEARCH_ENABLED=false
# 唯一的写操作。内容可能是模型转述的网页,写进知识库就等于让注入内容获得持久化,
# 并在之后每一轮 RAG 里被复用,所以默认关闭。
TOOL_WRITE_KNOWLEDGE_ENABLED=false
AGENT_WRITE_MAX_CHARS=20000
# 删除知识库文档。破坏性写操作:除了开关之外,还要求用户在对话里明确说过要删
# (确认令牌)且 document_id 真实存在(参数锚定),并且与真实 API 一致仅管理员可删。
TOOL_DELETE_KNOWLEDGE_ENABLED=false
# 澄清工具:模型拿不准用户意图或关键参数缺失时,把问题抛回用户,回合在此终止。
TOOL_ASK_USER_ENABLED=false
# 网页抓取:把 URL 抓成纯文本再过护栏(外部内容,注入面比 web_search 更大)。
TOOL_WEB_FETCH_ENABLED=false
# 单个页面允许读取的字节上限 / 注入上下文的字符上限 / 超时
WEB_FETCH_MAX_BYTES=204800
WEB_FETCH_MAX_CHARS=8000
WEB_FETCH_TIMEOUT_SECONDS=10.0
# 同一工具在一次回答里连续失败(参数错误或通道故障)多少次后,从本轮 schema 移除。
# 0 表示关闭(每次失败都会回灌给模型,由它自己决定是否继续试)。
TOOL_CIRCUIT_BREAKER_FAILURES=2

# 读附件的上限(字节 / 注入上下文的字符)
ATTACHMENT_READ_MAX_BYTES=5242880
ATTACHMENT_READ_MAX_CHARS=8000

# web 搜索。provider 为空或缺 key 时这个工具根本不注册,
# 而不是注册一个每轮都失败的版本。
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
# 留空用提供商默认端点;填了可指向自建代理或区域端点
WEB_SEARCH_BASE_URL=
WEB_SEARCH_RESULTS=5
WEB_SEARCH_SNIPPET_CHARS=300
WEB_SEARCH_TIMEOUT_SECONDS=10

# 视觉
# 能接收 image_url 内容块的模型白名单(逗号分隔)。留空即关闭:图片仍以 Markdown
# 链接留在提示词里,也就是模型其实看不见。填成 glm-4v 这类真正的视觉模型名。
VISION_MODELS=
# 单张图片字节上限。base64 会把体积放大三分之一
VISION_MAX_IMAGE_BYTES=4194304
# 一轮最多带几张。图片按面积折算 token,一张高清图能顶几千字
VISION_MAX_IMAGES=4

# Redis 配置 (可选)
REDIS_URL=redis://localhost:6379/0

# JWT 认证配置
JWT_SECRET_KEY=your-secret-key-change-this-in-production-please-make-it-very-long-and-random
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
